class Solution {
public:
    int maxProduct(vector<int>& nums) {
        int a=0 ;
            int b=0 ; int k =-1;
        for(int i=0;i<nums.size();i++){
            if(nums[i]>a){
                a=nums[i];
                k=i;
            }
        }
     for (int i=0;i<nums.size();i++){
        if (nums[i]>b && i!=k ){
            b=nums[i];
        }
     }
     return (a-1)*(b-1);
    }
};